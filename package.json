{
    "name": "fish-book",
    "version": "1.0.0",
    "description": "A discreet local TXT reader for desktop.",
    "author": "mofabo",
    "private": true,
    "engines": {
        "node": ">=24.14.0 <25"
    },
    "resolutions": {
        "@achrinza/node-ipc": "9.2.10"
    },
    "overrides": {
        "@achrinza/node-ipc": "9.2.10"
    },
    "scripts": {
        "dev": "node electron/dev.cjs",
        "web:dev": "vite --host 127.0.0.1",
        "build": "vite build",
        "test": "node --test tests/**/*.test.cjs",
        "lint": "eslint \"src/**/*.{js,jsx}\" \"electron/**/*.cjs\" \"tests/**/*.cjs\"",
        "electron:build": "vite build && electron-builder",
        "electron:dev": "yarn run dev",
        "postinstall": "electron-builder install-app-deps",
        "postuninstall": "electron-builder install-app-deps"
    },
    "main": "electron/main.cjs",
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-tooltip": "^1.2.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cn": "^0.3.0",
        "electron-store": "^8.1.0",
        "fflate": "0.8.3",
        "htmlparser2": "10.0.0",
        "iconv-lite": "^0.6.3",
        "jschardet": "^3.0.0",
        "lucide-react": "^0.468.0",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4",
        "shadcn": "^4.21.0",
        "tailwind-merge": "^3.3.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "electron": "^25.0.1",
        "electron-builder": "^22.14.13",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.0"
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "browser": true,
            "es2022": true,
            "node": true
        },
        "extends": [
            "eslint:recommended"
        ],
        "plugins": [
            "react"
        ],
        "settings": {
            "react": {
                "version": "detect"
            }
        },
        "parserOptions": {
            "ecmaVersion": "latest",
            "sourceType": "module",
            "ecmaFeatures": {
                "jsx": true
            }
        },
        "rules": {
            "react/jsx-uses-vars": "error",
            "no-unused-vars": [
                "error",
                {
                    "argsIgnorePattern": "^_"
                }
            ]
        },
        "overrides": [
            {
                "files": [
                    "electron/**/*.cjs",
                    "tests/**/*.cjs"
                ],
                "parserOptions": {
                    "sourceType": "script"
                }
            }
        ]
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ]
}
